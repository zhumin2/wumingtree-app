# 无名树 API 环境变量模板
# 复制为 /opt/wumingtree/wumingtree.env 后逐项填写；真身不入仓库（架构设计 5.1）。
# 生产必改项：JWT_SECRET、FILE_KEY、DB_DSN、SMS/AUDIT/PUSH 凭证。

# dev / staging / prod（prod 缺密钥将拒绝启动）
ENV=dev

# HTTP 监听地址
APP_ADDR=:8080

# MySQL（为空则跳过连接，healthz 报告 db=false）
DB_DSN=wumingtree:CHANGE_ME@tcp(127.0.0.1:3306)/wumingtree?parseTime=true&loc=UTC

# Redis（为空则跳过）
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=

# 会话密钥：openssl rand -hex 32
JWT_SECRET=

# 手机号加密主密钥：openssl rand -hex 32（64 位 hex = 32 字节 AES-256）
FILE_KEY=

# 短信：mock（联调固定验证码）/ remote
SMS_TYPE=mock
SMS_SECRET=

# 内容审核：mock（关键词表）/ remote（云内容安全）
AUDIT_MODE=mock
AUDIT_SECRET=

# 推送凭证（M5 接入）
PUSH_SECRET=

# 文件分发外链基地址（架构设计 3.9 抽象；触模换 OSS 只改实现不改调用方）
PUBLIC_BASE_URL=

# 本地上传根目录（systemd ReadWritePaths 须包含）
UPLOADS_DIR=/opt/wumingtree/uploads

# 用户端 Web 产物目录（Flutter Web 构建产物；为空则不托管）
WEB_DIR=/opt/wumingtree/web
