.hero {
  padding: 60rpx 0 48rpx;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--wmt-ink);
  line-height: 1.4;
}

.hero-sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--wmt-sky-deep);
  line-height: 1.7;
}

.go-login {
  text-align: center;
  color: var(--wmt-green-deep);
  font-size: 26rpx;
  padding: 32rpx 0;
}

.agree-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.agree-box {
  flex: none;
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid var(--wmt-divider);
  border-radius: 8rpx;
  background: var(--wmt-card);
  color: #ffffff;
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: center;
  margin: 4rpx 12rpx 0 0;
}

.agree-box-on {
  background: var(--wmt-green);
  border-color: var(--wmt-green);
}

.agree-text {
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--wmt-sky-deep);
}

.agree-link {
  color: var(--wmt-green-deep);
}
